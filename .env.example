# Copy to .env (never committed) and fill in. In production set these in Railway -> Variables.

# Port to listen on (Railway sets this automatically)
PORT=3000

# Frontend address(es) allowed to call this API, comma-separated (no trailing slash)
FRONTEND_URL=https://app.mavera.ai
# This API's own public address (used in login, email-confirmation and password links)
BETTER_AUTH_URL=https://api.mavera.ai
# Long random secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=

# MongoDB Atlas (Connect -> Drivers -> Node.js)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER-HOST.mongodb.net/mavera?retryWrites=true&w=majority
MONGODB_DB=mavera

# n8n content API shared secret
SM_API_SECRET=

# Sub-account provisioning API (docs/API-SUBACCOUNT-PROVISIONING.md), 32+ characters
PROVISIONING_API_SECRET=
# Monthly allowances every new brand receives (agency admins can change each brand later)
DEFAULT_MONTHLY_VIDEO_LIMIT=10
DEFAULT_MONTHLY_IMAGE_LIMIT=30

# Email via Resend (verification, password reset, invitations, welcome)
RESEND_API_KEY=
MAIL_FROM="Mavera AI <hello@mavera.ai>"
# Mavera Socials onboarding email (provisioning API) goes out through this n8n webhook, from maverick@mavera.ai.
# Private URL (no key): set it only here and in Railway. Leave empty to send it through Resend instead.
ONBOARDING_EMAIL_WEBHOOK_URL=

# Only when the frontend and API are on unrelated domains (e.g. *.pages.dev + *.up.railway.app): none
# Leave unset (lax) for app.mavera.ai + api.mavera.ai
# COOKIE_SAMESITE=none
